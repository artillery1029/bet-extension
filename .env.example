# This independent project only records local simulations. No venue credentials.
XHH_HOST_MODE=simulation
XHH_HOST_BIND=127.0.0.1
XHH_HOST_PORT=7073
# After loading ./dist in Chrome, set the exact extension ID (32 letters a-p).
XHH_HOST_EXTENSION_IDS=
# Optional absolute database directory. Default: LOCALAPPDATA/xhh-bet/host.
# XHH_HOST_DATA_DIR=D:/xhh-bet-data/local-simulation

{
  "manifest_version": 3,
  "name": "XHH Bet · 本地模拟",
  "version": "0.1.0",
  "description": "连接本机仅模拟宿主，查看模拟意图和持久化状态；不签名、不下单、不访问交易平台。",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "XHH Bet · 仅模拟", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:7073" }
}
